{
  "name": "ku-settle",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "pnpm run test:i18n && vitest run",
    "test:i18n": "node --experimental-strip-types scripts/validate-i18n.mjs",
    "test:unit": "vitest run",
    "test:api": "vitest run tests/server-api.test.ts",
    "test:integration": "node scripts/integration-support.mjs",
    "test:migration": "vitest run tests/migration.test.ts",
    "audit:anon": "node scripts/audit-anon-supabase.mjs",
    "audit:edge-negative": "node scripts/audit-edge-negative.mjs",
    "audit:remote": "node scripts/audit-remote-schema.mjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "test:db": "supabase test db"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "i18next": "^26.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "standardwebhooks": "1.0.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
