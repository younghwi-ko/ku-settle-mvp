NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Edge Function secrets. Set with `supabase secrets set`; never expose these to the browser.
RESEND_API_KEY=
SEND_EMAIL_HOOK_SECRET=
AUTH_EMAIL_FROM=
AUTH_EMAIL_REPLY_TO=
APP_URL=

SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_TOKEN=
# Kakao Local API: REST key is server-only; JavaScript key is restricted by Kakao Web domains.
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=
# Safety cap for Kakao REST calls per UTC calendar month. Defaults to 2,900,000.
KAKAO_MONTHLY_CALL_LIMIT=2900000
